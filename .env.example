# IONOS API Key: the full "<public prefix>.<secret>" string, dot included (example value, not a real key)
IONOS_API_KEY=3f2a9c1b7d4e48a6b5c0d9e8f7a61234.Qm9xV2tYcEw3ZGhOa1JzTHpBdUZqQ0VpU0hnb1BuMTIzNDU2Nzg5MGFiY2RlZg

# Domains to update (comma-separated)
IONOS_DOMAINS=example.com,subdomain.example.com

# Update interval in seconds (default: 300 = 5 minutes)
UPDATE_INTERVAL_SECONDS=300

# Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Heartbeat log interval in seconds (default: 21600 = 6 hours)
HEARTBEAT_INTERVAL_SECONDS=21600

# Health check endpoint port (default: 8080)
HEALTH_PORT=8080
